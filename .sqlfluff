# Референсный конфиг линтера (SQLFluff).
#
# ВНИМАНИЕ: на этапе трейсер-пули (тикет 01) здесь ровно одно правило —
# SYN-003 (`<>` вместо `!=`). По мере добавления правил (тикеты 05–10)
# конфиг расширяется. Не добавляйте сюда правила, не предусмотренные тикетом.

[sqlfluff]
dialect = postgres
templater = raw
rules = convention.not_equal,capitalisation.identifiers,references.keywords

[sqlfluff:rules:convention.not_equal]
# SYN-003: сравнение «не равно» — только через `<>` (ANSI), а не `!=`.
preferred_not_equal_style = ansi

[sqlfluff:rules:capitalisation.identifiers]
# NAM-001: имена объектов — snake_case (строчными буквами).
extended_capitalisation_policy = snake

[sqlfluff:rules:references.keywords]
# NAM-003: не использовать ключевые слова SQL как идентификаторы.
unquoted_identifiers_policy = aliases